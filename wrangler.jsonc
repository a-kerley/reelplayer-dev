{
  // Deploys the repo root as a static-assets Worker (Cloudflare's current
  // hosting path for a plain no-build static site, replacing classic Pages
  // project creation in the dashboard). Unrelated to worker/wrangler.toml,
  // which deploys the separate reelplayer-api Worker from that subdirectory -
  // wrangler only reads config from the current working directory, so the two
  // never collide.
  "name": "reelplayer-app",
  "compatibility_date": "2024-11-01",
  "main": "src/index.js",
  // Two hostnames, one Worker: reels.boxedape.com is the public surface
  // (player embeds, /p/<slug> pages, public API reads + stats beacons);
  // reels-admin.boxedape.com is the builder, behind Cloudflare Access for
  // the whole host. Separate origins so nothing on the embeddable public
  // origin can ever reach the builder's session. workers.dev stays on so
  // embed codes/page links issued before the custom domains keep working.
  "workers_dev": true,
  "routes": [
    { "pattern": "reels.boxedape.com", "custom_domain": true },
    { "pattern": "reels-admin.boxedape.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    // Deliberately left at the default html_handling ("auto-trailing-slash")
    // rather than "none" - "none" also disables the automatic "/" ->
    // "/index.html" resolution, which 404'd the bare domain entirely. The
    // default's clean-URL redirect (player.html -> /player) is instead
    // avoided by having embedExporter.js generate the canonical extensionless
    // url directly, so embeds never hit the redirect either.
    "binding": "ASSETS",
    // Only the paths src/index.js actually handles run the Worker first: the
    // builder page's redirect-to-reels-admin ("/", "/index.html"), the
    // /p/<slug> page rewrite, and /api/* forwarding. Everything else (player, css, js,
    // fonts) is served as a plain
    // static asset - free and uncounted, whereas running the script first
    // made every embed load cost ~20 metered Worker requests. /index (the
    // clean-URL form) needs no entry: asset handling 307s it to "/".
    "run_worker_first": ["/", "/index.html", "/p/*", "/api/*"]
  },
  // /api/* is forwarded to the reelplayer-api Worker (worker/) over this
  // internal binding, so the builder, player and pages call the API on
  // their own origin - no CORS, and one origin for Cloudflare Access's
  // session cookie to cover. The API's own workers.dev URL still works.
  "services": [
    { "binding": "API", "service": "reelplayer-api" }
  ]
}
