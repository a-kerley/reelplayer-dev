{
  // Deploys the repo root as a static-assets Worker (Cloudflare's current
  // hosting path for a plain no-build static site, replacing classic Pages
  // project creation in the dashboard). Unrelated to worker/wrangler.toml,
  // which deploys the separate reelplayer-api Worker from that subdirectory -
  // wrangler only reads config from the current working directory, so the two
  // never collide.
  "name": "reelplayer-app",
  "compatibility_date": "2024-11-01",
  "main": "src/index.js",
  "assets": {
    "directory": "./",
    // Deliberately left at the default html_handling ("auto-trailing-slash")
    // rather than "none" - "none" also disables the automatic "/" ->
    // "/index.html" resolution, which 404'd the bare domain entirely. The
    // default's clean-URL redirect (player.html -> /player) is instead
    // avoided by having embedExporter.js generate the canonical extensionless
    // url directly, so embeds never hit the redirect either.
    "binding": "ASSETS",
    // Only the paths src/index.js actually handles run the Worker first: the
    // builder's password gate ("/", "/index.html") and the /p/<slug> page
    // rewrite. Everything else (player, css, js, fonts) is served as a plain
    // static asset - free and uncounted, whereas running the script first
    // made every embed load cost ~20 metered Worker requests. /index (the
    // clean-URL form) needs no entry: asset handling 307s it to "/", which
    // is gated.
    "run_worker_first": ["/", "/index.html", "/p/*"]
  },
  // Failed builder-password attempts per IP (src/index.js) - the IP is only
  // the in-memory counting key, never stored. period must be 10 or 60.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } }
  ]
}
